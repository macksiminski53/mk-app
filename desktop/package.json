{
  "name": "mk-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Native desktop wrapper for MK with real OS notifications and sounds for new messages and calls.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mk.desktop",
    "productName": "MK",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "build/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerSidebar": "build/installSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
